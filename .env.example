# Copy this file to .env and adjust values for your setup.

# Leave DATABASE_URL unset (or use the sqlite line) for zero-setup local demos.
# For the "real" MySQL-backed setup described in the project report, run
# schema.sql against a MySQL server and point DATABASE_URL at it instead.

# DATABASE_URL=sqlite:///local.db
# DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/hybrid_cloud_analyzer

# Optional: enables analyzer/aws_enrichment.py to pull live tag/metadata
# from AWS for resources referenced in a Terraform plan. Safe to leave
# unset -- the pipeline falls back to Terraform-declared tags only.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# ENABLE_AWS_ENRICHMENT=false
